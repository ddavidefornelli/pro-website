# Public browser configuration for the same Supabase project as the Mac app.
# Replace both placeholders before running/building the application.
# Never put service-role, Clerk secret, OpenAI, or other privileged keys in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
