{
  "name": "prune-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "node --experimental-strip-types scripts/build-release.mjs",
    "check:deployment": "node --experimental-strip-types scripts/check-deployment.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:production": "node --experimental-strip-types scripts/check-production.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "solid-js": "^1.9.17",
    "supabase": "^2.122.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
